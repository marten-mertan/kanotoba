# Cloudflare account and D1 resource configuration.
KANOTOBA_WORKER_NAME=kanotoba-api
KANOTOBA_D1_DATABASE_NAME=kanotoba-db
KANOTOBA_D1_DATABASE_ID=PASTE_D1_DATABASE_ID_HERE

# Used by Wrangler for non-interactive CI/CD or local scripted deployments.
# Keep the real token in your ignored .env file or GitHub Actions Secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional source URL/revision for importing KanjiAlive language data.
# Pin to an immutable commit SHA for reproducible imports.
KANOTOBA_KANJI_SOURCE_URL=https://raw.githubusercontent.com/kanjialive/kanji-data-media/master/language-data/ka_data.csv
KANOTOBA_KANJI_SOURCE_REVISION=master

# Used by scripts/test-api.mjs. For local development, keep the default.
KANOTOBA_API_BASE_URL=http://127.0.0.1:8787
