# Backend Worker URL (origin only; do not add /api).
# Local Wrangler example:
API_URL=http://127.0.0.1:8787

# Set true only when running the frontend locally and you need to inspect
# unpublished/draft content from the Worker.
PREVIEW_MODE=false

# The value of the Worker's preview secret.
# Used only when PREVIEW_MODE=true; never commit the real value.
PREVIEW_API_KEY=

# Example for a remote test Worker:
# API_URL=https://your-test-worker.example.workers.dev

# Optional: for a Nuxt server deployment, this prefixed variable can override
# API_URL at runtime without rebuilding. For static deployments, set API_URL
# before `npm run generate` because the value is embedded in the generated app.
# NUXT_PUBLIC_API_URL=https://your-test-worker.example.workers.dev
