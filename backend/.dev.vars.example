# Local Worker runtime variables. Copy to backend/.dev.vars.
# Keep backend/.dev.vars out of Git.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate a unique random value of at least 32 characters.
# Used only for previewing unpublished grammar and quiz content.
PREVIEW_API_KEY=replace-with-a-random-secret-at-least-32-characters
